<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ElectricalImpedanceTomography.Views.MainPage"
             xmlns:viewmodels="clr-namespace:ElectricalImpedanceTomography.ViewModels"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             xmlns:converters="clr-namespace:ElectricalImpedanceTomography.Converters"
             xmlns:messages="clr-namespace:Utility.Classes.Application;assembly=Utility"
             x:DataType="viewmodels:MainPageViewModel"
             Shell.NavBarIsVisible="False"
             Title="MainPage"
             BackgroundColor="#0f172a">

    <ContentPage.Resources>
        <!-- COLOR PALETTE -->
        <Color x:Key="Slate950">#020617</Color>
        <Color x:Key="Slate900">#0f172a</Color>
        <Color x:Key="Slate800">#1e293b</Color>
        <Color x:Key="Slate700">#334155</Color>
        <Color x:Key="Slate600">#475569</Color>
        <Color x:Key="Slate400">#94a3b8</Color>
        <Color x:Key="Slate200">#e2e8f0</Color>
        <Color x:Key="BrandBlue">#3b82f6</Color>
        <Color x:Key="BrandGreen">#22c55e</Color>
        <Color x:Key="BrandRed">#ef4444</Color>

        <!-- VECTOR ICONS (High Quality Lucide Paths) -->
        <PathGeometry x:Key="IconCpu" Figures="M12 2v2 M12 20v2 M2 12h2 M20 12h2 M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z M9 9h6v6H9z" />
        <PathGeometry x:Key="IconServer" Figures="M2 12h20 M2 8h20 M2 4h20a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z M6 6h.01 M6 18h.01" />
        <PathGeometry x:Key="IconGrid" Figures="M3 3h7v7H3z M14 3h7v7h-7z M14 14h7v7h-7z M3 14h7v7H3z" />
        <PathGeometry x:Key="IconMonitor" Figures="M4 3h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z m8 14v4 m-4 0h8 M 10 8 l 4.5 2.5 a 0.5 0.5 0 0 1 0 1 L 10 14 a 0.5 0.5 0 0 1 -0.75 -0.4 V 8.4 A 0.5 0.5 0 0 1 10 8 z" />
        <PathGeometry x:Key="IconBriefcase" Figures="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16 M2 7h20v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7z M2 11h20" />
        <PathGeometry x:Key="IconBox" Figures="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z M3.27 6.96 12 12.01l8.73-5.05 M12 22.08V12" />
        <PathGeometry x:Key="IconSettings" Figures="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.38a2 2 0 0 0-.73-2.73l-.15-.1a2 2 0 0 1-1-1.72v-.51a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z" />
        <PathGeometry x:Key="IconSliders" Figures="M4 21v-7 M4 10V3 M12 21v-9 M12 8V3 M20 21v-5 M20 12V3 M1 14h6 M9 8h6 M17 16h6" />
        <PathGeometry x:Key="IconTerminal" Figures="M4 17l6-6-6-6 M12 19h8" />

        <!-- STYLES -->
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource Slate800}"/>
            <Setter Property="Stroke" Value="{StaticResource Slate700}"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 8"/>
            <Setter Property="Padding" Value="15"/>
        </Style>
        <Style x:Key="NavButtonStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource Slate800}"/>
            <Setter Property="Stroke" Value="{StaticResource Slate700}"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HeightRequest" Value="60"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="Open Sans"/>
            <Setter Property="TextColor" Value="{StaticResource Slate200}"/>
        </Style>
        <Style x:Key="AcronymLetter" TargetType="Span">
            <Setter Property="TextColor" Value="{StaticResource BrandBlue}"/>
            <Setter Property="FontSize" Value="Medium"/>
            <Setter Property="FontAttributes" Value="Bold"/>
        </Style>
        <Style x:Key="AcronymWord" TargetType="Span">
            <Setter Property="FontSize" Value="Medium"/>
            <Setter Property="TextColor" Value="{StaticResource Slate400}"/>
        </Style>

        <converters:MessageTypeToColorConverter x:Key="MessageTypeToColorConverter"/>
    </ContentPage.Resources>

    <Grid ColumnDefinitions="280, *, 320"
          Padding="0">

        <!-- LEFT SIDEBAR -->
        <Grid Grid.Column="0" 
              RowDefinitions="Auto, Auto, *"
              RowSpacing="15"
              Padding="15"
              BackgroundColor="{StaticResource Slate900}">

            <!-- Hardware Info -->
            <VerticalStackLayout Grid.Row="0" Spacing="8">
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                    <Path Fill="{StaticResource Slate700}" Data="{StaticResource IconCpu}" HorizontalOptions="Start" VerticalOptions="Center" Aspect="Uniform" HeightRequest="14" WidthRequest="14"/>
                    <Label Grid.Column="1" Text="HARDWARE INFO" TextColor="{StaticResource Slate700}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center"/>
                </Grid>

                <Border Style="{StaticResource PanelStyle}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Amplitude" TextColor="{StaticResource Slate400}" FontSize="13"/>
                            <Label Text="{Binding CurrentAmplitude, StringFormat='{0:F2} mA'}" FontAttributes="Bold" HorizontalOptions="End"/>
                        </Grid>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Frequency" TextColor="{StaticResource Slate400}" FontSize="13"/>
                            <Label Text="{Binding ExcitationFrequency, StringFormat='{0:F0} kHz'}" FontAttributes="Bold" HorizontalOptions="End"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource Slate700}" Margin="0,5"/>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Status" VerticalOptions="Center" TextColor="{StaticResource Slate400}" FontSize="13"/>
                            <Border StrokeShape="RoundRectangle 4" BackgroundColor="#1Aef4444" StrokeThickness="0" HorizontalOptions="End" Padding="8,2">
                                <Label Text="{Binding HardwareConnectionText}" TextColor="{Binding HardwareStatusColor}" FontSize="11" FontAttributes="Bold"/>
                            </Border>
                        </Grid>
                        <Button Clicked="OnConnectButtonClicked" Margin="0,5,0,0" CornerRadius="6" FontAttributes="Bold" Padding="0,10">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding HardwareConnected}" Value="True">
                                    <Setter Property="Text" Value="Disconnect"/>
                                    <Setter Property="BackgroundColor" Value="{StaticResource BrandRed}"/>
                                    <Setter Property="TextColor" Value="White"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Button" Binding="{Binding HardwareConnected}" Value="False">
                                    <Setter Property="Text" Value="Connect"/>
                                    <Setter Property="BackgroundColor" Value="{StaticResource BrandGreen}"/>
                                    <Setter Property="TextColor" Value="{StaticResource Slate900}"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Navigation -->
            <VerticalStackLayout Grid.Row="1" Spacing="8">
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                    <Path Fill="{StaticResource Slate700}" Data="{StaticResource IconServer}" HorizontalOptions="Start" VerticalOptions="Center" Aspect="Uniform" HeightRequest="14" WidthRequest="14"/>
                    <Label Grid.Column="1" Text="NAVIGATION" TextColor="{StaticResource Slate700}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center"/>
                </Grid>

                <VerticalStackLayout Spacing="8">
                    <!-- Hardware Button -->
                    <Border Style="{StaticResource NavButtonStyle}">
                        <Grid ColumnDefinitions="50, *">
                            <Border Grid.Column="0" BackgroundColor="{StaticResource Slate700}" StrokeThickness="0" VerticalOptions="Fill" HorizontalOptions="Fill" Padding="12">
                                <Path Data="{StaticResource IconServer}" Stroke="White" StrokeThickness="2" Aspect="Uniform" VerticalOptions="Center" HorizontalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1" Text="Hardware" VerticalOptions="Center" Margin="15,0,0,0" FontAttributes="Bold" FontSize="14" TextColor="White"/>
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavigationMenuTapped" CommandParameter="DAQPage"/>
                        </Border.GestureRecognizers>
                    </Border>
                    <!-- Meshing Button -->
                    <Border Style="{StaticResource NavButtonStyle}">
                        <Grid ColumnDefinitions="50, *">
                            <Border Grid.Column="0" BackgroundColor="{StaticResource Slate700}" StrokeThickness="0" VerticalOptions="Fill" HorizontalOptions="Fill" Padding="12">
                                <Path Data="{StaticResource IconGrid}" Stroke="White" StrokeThickness="2" Aspect="Uniform" VerticalOptions="Center" HorizontalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1" Text="Meshing" VerticalOptions="Center" Margin="15,0,0,0" FontAttributes="Bold" FontSize="14" TextColor="White"/>
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavigationMenuTapped" CommandParameter="MeshingPage"/>
                        </Border.GestureRecognizers>
                    </Border>
                    <!-- Reconstruction Button -->
                    <Border Style="{StaticResource NavButtonStyle}">
                        <Grid ColumnDefinitions="50, *">
                            <Border Grid.Column="0" BackgroundColor="{StaticResource Slate700}" StrokeThickness="0" VerticalOptions="Fill" HorizontalOptions="Fill" Padding="12">
                                <Path Data="{StaticResource IconMonitor}" Stroke="White" StrokeThickness="2" Aspect="Uniform" VerticalOptions="Center" HorizontalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1" Text="Reconstruction" VerticalOptions="Center" Margin="15,0,0,0" FontAttributes="Bold" FontSize="14" TextColor="White"/>
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavigationMenuTapped" CommandParameter="ReconstructionPage"/>
                        </Border.GestureRecognizers>
                    </Border>
                    <!-- Configuration Button -->
                    <Border Style="{StaticResource NavButtonStyle}">
                        <Grid ColumnDefinitions="50, *">
                            <Border Grid.Column="0" BackgroundColor="{StaticResource Slate700}" StrokeThickness="0" VerticalOptions="Fill" HorizontalOptions="Fill" Padding="12">
                                <Path Data="{StaticResource IconSettings}" Stroke="White" StrokeThickness="2" Aspect="Uniform" VerticalOptions="Center" HorizontalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1" Text="Configuration" VerticalOptions="Center" Margin="15,0,0,0" FontAttributes="Bold" FontSize="14" TextColor="White"/>
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavigationMenuTapped" CommandParameter="ReconstructionConfigurationPage"/>
                        </Border.GestureRecognizers>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Toolbox -->
            <VerticalStackLayout Grid.Row="2" VerticalOptions="End" Spacing="8">
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                    <Path Fill="{StaticResource Slate700}" Data="{StaticResource IconBriefcase}" HorizontalOptions="Start" VerticalOptions="Center" Aspect="Uniform" HeightRequest="14" WidthRequest="14"/>
                    <Label Grid.Column="1" Text="TOOLBOX" TextColor="{StaticResource Slate700}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center"/>
                </Grid>
                <Button Text="Load Measurement" Clicked="OnLoadMeasurementClicked" BackgroundColor="{StaticResource Slate800}" TextColor="{StaticResource Slate200}" BorderColor="{StaticResource Slate700}" BorderWidth="1" CornerRadius="6" HeightRequest="40" FontSize="12"/>
                <Button Text="Load Mesh" Clicked="OnLoadMeshClicked" BackgroundColor="{StaticResource Slate800}" TextColor="{StaticResource Slate200}" BorderColor="{StaticResource Slate700}" BorderWidth="1" CornerRadius="6" HeightRequest="40" FontSize="12"/>
            </VerticalStackLayout>
        </Grid>

        <!-- CENTER WORKSPACE -->
        <Grid Grid.Column="1">
            <!-- BACKGROUND LAYER: Dotted Pattern -->
            <GraphicsView x:Name="BackgroundGraphics"
                          InputTransparent="True"/>

            <!-- CONTENT LAYER -->
            <Grid RowDefinitions="Auto, *, Auto" Padding="20, 40, 20, 20">
                <!-- 1. Header -->
                <VerticalStackLayout Grid.Row="0" HorizontalOptions="Center" Spacing="5">
                    <skia:SKCanvasView x:Name="HeaderCanvasView"
                                       HeightRequest="100"
                                       WidthRequest="600"
                                       PaintSurface="OnHeaderPaintSurface"
                                       HorizontalOptions="Center"
                                       BackgroundColor="Transparent"/>
                    <Label HorizontalOptions="Center" HorizontalTextAlignment="Center" LineHeight="1.2">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="I" Style="{StaticResource AcronymLetter}"/>
                                <Span Text="mpedance " Style="{StaticResource AcronymWord}"/>
                                <Span Text="T" Style="{StaticResource AcronymLetter}"/>
                                <Span Text="omography " Style="{StaticResource AcronymWord}"/>
                                <Span Text="&amp; " FontAttributes="Italic" TextColor="{StaticResource Slate700}"/>
                                <Span Text=" E" Style="{StaticResource AcronymLetter}"/>
                                <Span Text="lectrical " Style="{StaticResource AcronymWord}"/>
                                <Span Text="R" Style="{StaticResource AcronymLetter}"/>
                                <Span Text="esistance " Style="{StaticResource AcronymWord}"/>
                                <Span Text="A" Style="{StaticResource AcronymLetter}"/>
                                <Span Text="nalysis" Style="{StaticResource AcronymWord}"/>
                                <Span Text="&#10;" />
                                <Span Text="for " FontAttributes="Italic" TextColor="{StaticResource Slate700}"/>
                                <Span Text=" T" Style="{StaticResource AcronymLetter}"/>
                                <Span Text="exture " Style="{StaticResource AcronymWord}"/>
                                <Span Text="E" Style="{StaticResource AcronymLetter}"/>
                                <Span Text="valuation" Style="{StaticResource AcronymWord}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>

                <!-- 2. Mesh Visual -->
                <Grid Grid.Row="1" VerticalOptions="Center" HorizontalOptions="Center">
                    <BoxView WidthRequest="300" HeightRequest="300" CornerRadius="150" Color="#1A3b82f6" HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Border Style="{StaticResource PanelStyle}" BackgroundColor="#801e293b" Stroke="{StaticResource Slate700}" StrokeThickness="1" Padding="0" WidthRequest="400" HeightRequest="400">
                        <Grid RowDefinitions="36, *">
                            <Grid Grid.Row="0" BackgroundColor="#801e293b" Padding="12,0" ColumnDefinitions="Auto, *">
                                <Path Data="{StaticResource IconBox}" Stroke="{StaticResource BrandBlue}" Aspect="Uniform" HeightRequest="14" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="MESH PREVIEW" TextColor="{StaticResource Slate400}" FontSize="10" FontAttributes="Bold" VerticalOptions="Center" Margin="8,0,0,0"/>
                            </Grid>
                            <skia:SKCanvasView Grid.Row="1" x:Name="MeshCanvasView" BackgroundColor="Transparent" PaintSurface="OnCanvasViewPaintSurface" HorizontalOptions="Fill" VerticalOptions="Fill"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 3. Console -->
                <Border Grid.Row="2" Style="{StaticResource PanelStyle}" BackgroundColor="#CC1e293b" Padding="0" Margin="0,20,0,0" HeightRequest="200" VerticalOptions="End">
                    <Grid RowDefinitions="36, *, 40">
                        <Grid Grid.Row="0" BackgroundColor="#801e293b" Padding="12,0" ColumnDefinitions="Auto, *, Auto">
                            <Path Data="{StaticResource IconTerminal}" Stroke="{StaticResource BrandBlue}" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="SYSTEM CONSOLE" TextColor="{StaticResource Slate400}" FontSize="10" FontAttributes="Bold" VerticalOptions="Center" Margin="8,0,0,0"/>
                            <HorizontalStackLayout Grid.Column="2" Spacing="5" VerticalOptions="Center">
                                <BoxView Color="{StaticResource Slate700}" WidthRequest="8" HeightRequest="8" CornerRadius="4"/>
                                <BoxView Color="{StaticResource Slate700}" WidthRequest="8" HeightRequest="8" CornerRadius="4"/>
                            </HorizontalStackLayout>
                        </Grid>
                        <ScrollView Grid.Row="1" x:Name="ConsoleScroll" Padding="10">
                            <VerticalStackLayout x:Name="ConsoleStack" BindableLayout.ItemsSource="{Binding DebugLog}" Spacing="2">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="messages:WorkspaceMessage">
                                        <Grid ColumnDefinitions="Auto, *">
                                            <Label Text="{Binding Time, StringFormat='[{0:HH:mm:ss}] >> '}" TextColor="{StaticResource Slate700}" FontFamily="Consolas" FontSize="12"/>
                                            <Label Grid.Column="1" Text="{Binding Message}" TextColor="{Binding Type, Converter={StaticResource MessageTypeToColorConverter}}" FontFamily="Consolas" FontSize="12"/>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </ScrollView>
                        <Grid Grid.Row="2" ColumnDefinitions="Auto, *" BackgroundColor="{StaticResource Slate950}" Padding="10,0">
                            <Label Text=">" TextColor="{StaticResource BrandBlue}" VerticalOptions="Center" Margin="0,0,5,0" FontFamily="Consolas" FontAttributes="Bold"/>
                            <Entry Grid.Column="1" Text="{Binding ConsoleInput}" Placeholder="Enter command..." PlaceholderColor="{StaticResource Slate700}" TextColor="{StaticResource Slate200}" FontFamily="Consolas" FontSize="12" BackgroundColor="Transparent" Completed="OnConsoleEntryCompleted"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- RIGHT SIDEBAR: Config -->
        <Grid Grid.Column="2" BackgroundColor="{StaticResource Slate900}" RowDefinitions="Auto, *" Padding="15">
            <VerticalStackLayout Grid.Row="0" Spacing="15">
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                    <Path Fill="{StaticResource Slate700}" Data="{StaticResource IconSettings}" HorizontalOptions="Start" VerticalOptions="Center" Aspect="Uniform" HeightRequest="14" WidthRequest="14"/>
                    <Label Grid.Column="1" Text="CONFIGURATION" TextColor="{StaticResource Slate700}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center"/>
                </Grid>
                <VerticalStackLayout Spacing="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Solver Type" FontSize="12" TextColor="{StaticResource Slate400}"/>
                        <Border StrokeShape="RoundRectangle 6" Stroke="{StaticResource Slate700}" StrokeThickness="1" BackgroundColor="{StaticResource Slate950}" Padding="0">
                            <Picker ItemsSource="{Binding Solvers}" SelectedItem="{Binding ReconstructionParameters.DifferentialEquationSolver}" TextColor="{StaticResource Slate200}" TitleColor="{StaticResource Slate400}"/>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Regularization" FontSize="12" TextColor="{StaticResource Slate400}"/>
                        <Border StrokeShape="RoundRectangle 6" Stroke="{StaticResource Slate700}" StrokeThickness="1" BackgroundColor="{StaticResource Slate950}" Padding="0">
                            <Picker ItemsSource="{Binding Regularizations}" SelectedItem="{Binding ReconstructionParameters.RegularizationTechnique}" TextColor="{StaticResource Slate200}" TitleColor="{StaticResource Slate400}"/>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Error Metric" FontSize="12" TextColor="{StaticResource Slate400}"/>
                        <Border StrokeShape="RoundRectangle 6" Stroke="{StaticResource Slate700}" StrokeThickness="1" BackgroundColor="{StaticResource Slate950}" Padding="0">
                            <Picker ItemsSource="{Binding ErrorMetrics}" SelectedItem="{Binding ReconstructionParameters.ErrorMetric}" TextColor="{StaticResource Slate200}" TitleColor="{StaticResource Slate400}"/>
                        </Border>
                    </VerticalStackLayout>
                    <BoxView HeightRequest="1" Color="{StaticResource Slate800}" Margin="0,5"/>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Numeric Optimizer" FontSize="12" TextColor="{StaticResource Slate400}"/>
                        <Border StrokeShape="RoundRectangle 6" Stroke="{StaticResource Slate700}" StrokeThickness="1" BackgroundColor="{StaticResource Slate950}" Padding="0">
                            <Picker ItemsSource="{Binding NumericOptimizers}" SelectedItem="{Binding ReconstructionParameters.NumericOptimizer}" TextColor="{StaticResource Slate200}" TitleColor="{StaticResource Slate400}"/>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Numeric Solver" FontSize="12" TextColor="{StaticResource Slate400}"/>
                        <Border StrokeShape="RoundRectangle 6" Stroke="{StaticResource Slate700}" StrokeThickness="1" BackgroundColor="{StaticResource Slate950}" Padding="0">
                            <Picker ItemsSource="{Binding NumericSolvers}" SelectedItem="{Binding ReconstructionParameters.NumericSolver}" TextColor="{StaticResource Slate200}" TitleColor="{StaticResource Slate400}"/>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
            <Grid Grid.Row="1" VerticalOptions="End">
                <Label Text="Version 2.4.0" TextColor="{StaticResource Slate700}" FontSize="10" HorizontalOptions="End"/>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>