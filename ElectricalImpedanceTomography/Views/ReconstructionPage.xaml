<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ElectricalImpedanceTomography.ViewModels"
             xmlns:controls="clr-namespace:ElectricalImpedanceTomography.Controls"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             xmlns:models="clr-namespace:Utility.Classes;assembly=Utility"
             x:Class="ElectricalImpedanceTomography.Views.ReconstructionPage"
             x:Name="ReconstructionPageRoot"
             Title="ReconstructionPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Dark=#101B2B, Light=#F2E7D8}"
             x:DataType="viewmodels:ReconstructionPageViewModel">
    <ContentPage.MenuBarItems>
        <MenuBarItem Text="Reconstruction">
            <MenuFlyoutItem Text="Start"
                         Clicked="OnPlayPauseAcceleratorInvoked">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="None"
                                         Key="{OnPlatform WinUI=Spacebar, MacCatalyst=Spacebar}" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Step"
                         Clicked="OnStepAcceleratorInvoked">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="None"
                                         Key="{OnPlatform WinUI=Spacebar, MacCatalyst=Spacebar}" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Stop"
                            Clicked="OnStopAcceleratorInvoked">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="None"
                                         Key="{OnPlatform WinUI=Esc, MacCatalyst=Esc}" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
        </MenuBarItem>
    </ContentPage.MenuBarItems>

    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="SF Pro Text"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="TextColor" Value="#F0F4FF"/>
        </Style>
        <Style TargetType="skia:SKCanvasView">
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Stroke">
                <Setter.Value>
                    <SolidColorBrush Color="{AppThemeBinding Light=#3A7CA5, Dark=#4D6FA3}" />
                </Setter.Value>
            </Setter>
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="{AppThemeBinding Light=#883A7CA5, Dark=#66FFFFFF}" Offset="0,4" Radius="12" Opacity="0.45" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Picker">
            <Setter Property="TextColor" Value="#F0F4FF"/>
            <Setter Property="TitleColor" Value="#9DAAD3"/>
            <Setter Property="BackgroundColor" Value="Transparent"/>
        </Style>

        <Style TargetType="Entry">
            <Setter Property="TextColor" Value="#F0F4FF"/>
            <Setter Property="BackgroundColor" Value="Transparent"/>
        </Style>

        <Style x:Key="PanelSectionBorderStyle" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 10"/>
            <Setter Property="StrokeThickness" Value="0"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#242F47, Dark=#293756}"/>
        </Style>

        <Style x:Key="CanvasBorderStyle" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Stroke" Value="Transparent"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#1A2436, Dark=#1C2638}"/>
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="{AppThemeBinding Light=#663A7CA5, Dark=#66B3C2D6}" Offset="0,6" Radius="14" Opacity="0.5" />
                </Setter.Value>
            </Setter>
        </Style>

        <LinearGradientBrush x:Key="ConfigurationPanelBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{AppThemeBinding Light=#232E45, Dark=#1E273B}" Offset="0" />
            <GradientStop Color="{AppThemeBinding Light=#161D2C, Dark=#101624}" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ControlPanelBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{AppThemeBinding Light=#1E273B, Dark=#1E273B}" Offset="0" />
            <GradientStop Color="{AppThemeBinding Light=#101624, Dark=#101624}" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PartialResultsBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{AppThemeBinding Light=#202A3F, Dark=#202A3F}" Offset="0" />
            <GradientStop Color="{AppThemeBinding Light=#121923, Dark=#121923}" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FullResultsBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{AppThemeBinding Light=#1C2638, Dark=#1C2638}" Offset="0" />
            <GradientStop Color="{AppThemeBinding Light=#0F151F, Dark=#0F151F}" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HistoryPanelBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{AppThemeBinding Light=#222E45, Dark=#222E45}" Offset="0" />
            <GradientStop Color="{AppThemeBinding Light=#141B28, Dark=#141B28}" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="StatisticsPanelBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{AppThemeBinding Light=#1E2435, Dark=#1E2435}" Offset="0" />
            <GradientStop Color="{AppThemeBinding Light=#111723, Dark=#111723}" Offset="1" />
        </LinearGradientBrush>
    </ContentPage.Resources>
    
    
    <Grid RowDefinitions="*">
        <!--
        <controls:NavBarControl x:Name="NavBar" Grid.Row="0" Grid.ColumnSpan="1" CurrentPageName="ReconstructionPage"/>
        -->
        <!-- Main Grid For Page display -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto" Margin="5">
            <!-- Left hand Side controls-->
            <Border Style="{StaticResource PanelBorderStyle}"
                    MaximumWidthRequest="400"
                    Grid.Column="0"
                    Margin="5"
                    Background="{StaticResource ConfigurationPanelBrush}">
                <Border.Stroke>
                    <SolidColorBrush Color="{AppThemeBinding Light=#4D6FA3, Dark=#4D6FA3}" />
                </Border.Stroke>
                <VerticalStackLayout Margin="5" Spacing="10">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                        <Image Grid.Column="0" Source="icon_configuration.png" HeightRequest="35"/>
                        <Label Grid.Column="1" Text="Configuration" FontAttributes="Italic" FontSize="Large" TextColor="#F0F4FF"/>
                    </Grid>
                    <Grid ColumnDefinitions="Auto, Auto" ColumnSpacing="14" RowSpacing="0">
                        <!-- Method Selection -->
                        <Border Grid.Column="0"
                                Style="{StaticResource PanelSectionBorderStyle}"
                                BackgroundColor="{AppThemeBinding Light=#27344D, Dark=#27344D}">
                            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto" RowSpacing="8">
                                <Label Grid.Row="0" Text="Methods" FontSize="Medium" FontAttributes="Bold" Margin="0,0,0,12"/>
                                <Label Grid.Row="1" HorizontalOptions="Start" Text="DE Solver" FontFamily="SF Pro Text" FontAttributes="None"/>
                                <Picker Grid.Row="2" ItemsSource="{Binding DifferentialEquationSolverOptions}" SelectedItem="{Binding ReconstructionParameters.DifferentialEquationSolver}" WidthRequest="150"/>
                                <Label Grid.Row="3" HorizontalOptions="Start" Text="Error Metric" FontFamily="SF Pro Text" FontAttributes="None"/>
                                <Picker Grid.Row="4" HorizontalOptions="Start" ItemsSource="{Binding ErrorMetricOptions}" SelectedItem="{Binding ReconstructionParameters.ErrorMetric}" WidthRequest="150"/>
                                <Label Grid.Row="5" HorizontalOptions="Start" Text="Regularization" FontFamily="SF Pro Text" FontAttributes="None"/>
                                <Picker Grid.Row="6" ItemsSource="{Binding RegularizationTechniqueOptions}" SelectedItem="{Binding ReconstructionParameters.RegularizationTechnique}"/>
                                <Label Grid.Row="7" HorizontalOptions="Start" Text="Optimizer" FontFamily="SF Pro Text" FontAttributes="None"/>
                                <Picker Grid.Row="8" ItemsSource="{Binding NumericOptimizerOptions}" SelectedItem="{Binding ReconstructionParameters.NumericOptimizer}"/>
                                <Label Grid.Row="9" HorizontalOptions="Start" Text="Linear Solver" FontFamily="SF Pro Text" FontAttributes="None"/>
                                <Picker Grid.Row="10" ItemsSource="{Binding NumericSolverOptions}" SelectedItem="{Binding ReconstructionParameters.NumericSolver}" WidthRequest="150"/>
                                <Label Grid.Row="11" HorizontalOptions="Start" Text="{Binding ParallelizationToggleLabel}" FontFamily="SF Pro Text" FontAttributes="None"/>
                                <Switch Grid.Row="12" IsToggled="{Binding UseParallelizationToggle}" HorizontalOptions="Start"/>
                            </Grid>
                        </Border>
                        <!-- Parameter Configuration -->
                        <Border Grid.Column="1"
                                Style="{StaticResource PanelSectionBorderStyle}"
                                BackgroundColor="{AppThemeBinding Light=#25324A, Dark=#25324A}">
                            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto" RowSpacing="8">
                                <Label Grid.Row="0" Text="Parameters" FontSize="Medium" FontAttributes="Bold" Margin="0,0,0,12"/>
                                <Label Grid.Row="1" HorizontalOptions="Start" Text="Initial Distribution" FontFamily="SF Pro Text" FontAttributes="None"/>
                                <Picker Grid.Row="2" ItemsSource="{Binding InitialDistributionOptions}" SelectedItem="{Binding ReconstructionParameters.InitialDistributionType}"/>
                                <Label Grid.Row="3" HorizontalOptions="Start" Text="Max Iteration Count" FontFamily="SF Pro Text" FontAttributes="None"/>
                                <Entry Grid.Row="4" Text="{Binding MaxIterationCount}"/>
                                <Label Grid.Row="5" HorizontalOptions="Start" Text="Regularization Weight (θ)" FontFamily="SF Pro Text" FontAttributes="None"/>
                                <Entry Grid.Row="6" Text="{Binding RegularizationWeight}"/>
                                <Label Grid.Row="7" HorizontalOptions="Start" Text="Gradient Step Size (β)" FontFamily="SF Pro Text" FontAttributes="None"/>
                                <Entry Grid.Row="8" Text="{Binding StepSize}"/>
                                <Label Grid.Row="9" HorizontalOptions="Start" Text="Measurement Noise" FontFamily="SF Pro Text" FontAttributes="None"/>
                                <Picker Grid.Row="10" ItemsSource="{Binding MeasurementNoiseTypeOptions}" SelectedItem="{Binding ReconstructionParameters.MeasurementNoiseType}"/>
                                <Label Grid.Row="11" HorizontalOptions="Start" Text="Noise Amplitude / dB" FontFamily="SF Pro Text" FontAttributes="None"/>
                                <Entry Grid.Row="12"
                                       Text="{Binding ReconstructionParameters.MeasurementNoiseAmplitude}"
                                       Keyboard="Numeric"
                                       IsEnabled="{Binding IsNoiseAmplitudeEnabled}"/>
                                <Label Grid.Row="13"
                                       HorizontalOptions="Start"
                                       Text="Conductivity Bounds [S]"
                                       FontFamily="SF Pro Text"
                                       FontAttributes="None"/>
                                <Grid Grid.Row="14" ColumnDefinitions="*, *" ColumnSpacing="8">
                                    <Entry Grid.Column="0"
                                           Placeholder="Min"
                                           Keyboard="Numeric"
                                           Text="{Binding ReconstructionParameters.ConductivityMinimumBound}"/>
                                    <Entry Grid.Column="1"
                                           Placeholder="Max"
                                           Keyboard="Numeric"
                                           Text="{Binding ReconstructionParameters.ConductivityMaximumBound}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource PanelSectionBorderStyle}"
                            MaximumWidthRequest="350"
                            BackgroundColor="{AppThemeBinding Light=#253049, Dark=#253049}">
                        <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto" RowSpacing="8">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                <Image Grid.Column="0" Source="icon_boundary.png" HeightRequest="25"/>
                                <Label Grid.Column="1" Text="Boundary Conditions" FontAttributes="Italic" FontSize="Medium"/>
                            </Grid>
                            <Label Grid.Row="1" Text="Starting Excitation Electrode" FontAttributes="None"/>
                            <Entry Grid.Row="2" Text="{Binding ExcitationElectrodeId}"/>
                            <Label Grid.Row="3" Text="Starting Ground Electrode" FontAttributes="None"/>
                            <Entry Grid.Row="4" Text="{Binding GroundElectrodeId}"/>
                            <Label Grid.Row="5" Text="Drive Pattern:" FontAttributes="None"/>
                            <Grid Grid.Row="6" ColumnDefinitions="Auto, Auto, Auto, Auto" ColumnSpacing="10" HorizontalOptions="Center">
                                <Label Grid.Column="0" Margin="5" Text="Adjecent" VerticalOptions="Center" HorizontalOptions="Start" FontAttributes="None"/>
                                <CheckBox Grid.Column="1"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          IsChecked="{Binding AdjecentDrivePattern}"
                                          CheckedChanged="OnAdjecentDrivePatternChecked"/>
                                <Label Grid.Column="2" Margin="5" Text="Opposite" VerticalOptions="Center" HorizontalOptions="Start" FontAttributes="None"/>
                                <CheckBox Grid.Column="3"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          IsChecked="{Binding OppositeDrivePattern}"
                                          CheckedChanged="OnOppositeDrivePatternChecked"/>
                                </Grid>
                            <Button Grid.Row="7" Text="Edit Boundary Conditions" Background="#2F9E9C" TextColor="White" FontAttributes="Bold" Clicked="OnEditBoundaryConditionsClicked"/>
                        </Grid>
                    </Border>
                    <!--
                    <Border Style="{StaticResource PanelSectionBorderStyle}"
                            BackgroundColor="{AppThemeBinding Light=#22304A, Dark=#36404C}">
                        <VerticalStackLayout Spacing="12">
                            <Entry Text="{Binding Name}" Placeholder="Name" TextColor="{AppThemeBinding Light=White, Dark=#262E38}"/>
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                                <Button Grid.Column="0" Text="Save" BackgroundColor="#2E8B57" TextColor="White" FontFamily="SF Pro Text" FontAttributes="Bold" Clicked="OnSaveClicked"/>
                                <Button Grid.Column="1" Text="Load" BackgroundColor="#3A7CA5" TextColor="White" FontFamily="SF Pro Text" FontAttributes="Bold" Clicked="OnLoadClicked"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                    -->
                </VerticalStackLayout>
            </Border>

            <!-- Center Content -->
            <Grid Grid.Column="1" 
                  BackgroundColor="Transparent"
                  Margin="5"
                  RowDefinitions="Auto, Auto" 
                  HorizontalOptions="Center">

                <!-- Control Panel to control reconstruction -->
                    <Border Style="{StaticResource PanelBorderStyle}"                           
                            Grid.Row="0"
                            MaximumWidthRequest="1010"
                            Background="{StaticResource ControlPanelBrush}">
                    <Border.Stroke>
                        <SolidColorBrush Color="{AppThemeBinding Light=#3A5F8A, Dark=#3A5F8A}" />
                    </Border.Stroke>
                    <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto"
                          RowDefinitions="*, Auto"
                          ColumnSpacing="15"
                          HorizontalOptions="Center">
                        <Border x:Name="PlayButton" Grid.Column="0" HeightRequest="60" WidthRequest="60" Margin="5" HorizontalOptions="Center" VerticalOptions="Center" Stroke="Transparent">
                            <Image Source="icon_play_green.png" WidthRequest="40">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPlayButtonClicked"/>
                                </Image.GestureRecognizers>
                                <VisualStateManager.VisualStateGroups>
                                    
                                </VisualStateManager.VisualStateGroups>
                            </Image>
                        </Border>
                        <Border x:Name="PauseButton" Grid.Column="0" HeightRequest="50" WidthRequest="50" Margin="5" HorizontalOptions="Center" VerticalOptions="Center" Stroke="Transparent">
                            <Image Source="icon_pause_blue.png" WidthRequest="40">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPauseButtonClicked"/>
                                </Image.GestureRecognizers>
                            </Image>
                        </Border>
                        <Border x:Name="StepButton" Grid.Column="1" HeightRequest="50" WidthRequest="50" Margin="5" Stroke="Transparent">
                            <Image Source="icon_next_blue.png" WidthRequest="40">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnStepButtonClicked"/>
                                </Image.GestureRecognizers>
                            </Image>
                        </Border>
                        <Border x:Name="StopButton" Grid.Column="2" HeightRequest="50" WidthRequest="50" Margin="5" Stroke="Transparent">
                            <Image Source="icon_stop_red.png" WidthRequest="40">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnStopButtonClicked"/>
                                </Image.GestureRecognizers>
                            </Image>
                        </Border>

                        <Label Grid.Column="3" HorizontalOptions="Center" WidthRequest="100"  VerticalOptions="Center" FontFamily="SF Pro Text" Text="{Binding IterationCount, StringFormat='Iteration: {0}'}" TextColor="#F0F4FF"/>
                        <Label Grid.Column="4" HorizontalOptions="Center" WidthRequest="120" VerticalOptions="Center" FontFamily="SF Pro Text" Text="{Binding Residual, StringFormat='Residual: {0:F3}'}" TextColor="#F0F4FF"/>

                        <Border Grid.Column="5" Margin="2" Background="Transparent" Stroke="Transparent">
                            <Button Text="Reset Reconstruction" Margin="10" BackgroundColor="DarkRed" TextColor="White" FontAttributes="Bold" Clicked="OnResetReconstructionClicked"/>
                        </Border>
                        <Border Grid.Column="6" Margin="2" Background="Transparent" Stroke="Transparent">
                        </Border>
                        <Picker x:Name="PotentialModePicker"
                                Margin="5"
                                Grid.Column="7"
                                TitleColor="#9DAAD3"
                                TextColor="#F0F4FF"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                SelectedItem="Default"
                                Title="Potential Display Mode">
                            <Picker.Items>
                                <x:String>Default</x:String>
                                <x:String>Grayscale</x:String>
                                <x:String>Inverted</x:String>
                                <x:String>Heatmap</x:String>
                                <x:String>Rainbow</x:String>
                            </Picker.Items>
                        </Picker>
                        <Border Grid.Column="7" Grid.Row="1"  Background="Transparent" Stroke="Transparent">
                            <Button x:Name="ExportVideoButton"
                                    Text="Export"
                                    Margin="10"
                                    BackgroundColor="#3A7CA5"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    Clicked="OnExportClicked"
                                    IsEnabled="False"/>
                        </Border>
                        <Slider x:Name="PlaybackSlider"
                                Margin="5"
                                Grid.Row="1"
                                WidthRequest="250"
                                VerticalOptions="Center"
                                HorizontalOptions="Center"
                                Grid.ColumnSpan="3"
                                Minimum="0"
                                Maximum="0"
                                ValueChanged="OnPlaybackSliderValueChanged" />
                        <Label x:Name="PlaybackFrameLabel"
                               WidthRequest="100"
                               Grid.Row="1"
                               Grid.Column="3"
                               VerticalOptions="Center"
                               Text="0 / 0"
                               FontFamily="SF Pro Text"/>

                        <Image x:Name="PlayerBackButton"
                               Grid.Row="1"
                               Grid.Column="4"
                               Rotation="180"
                               Source="icon_next_player.png"
                               HeightRequest="35"
                               WidthRequest="35"
                               HorizontalOptions="End"
                               Margin="5"
                               IsEnabled="False">
                            <Image.Shadow>
                                <Shadow Brush="White" Opacity="1.0" Radius="1.0"/>
                            </Image.Shadow>
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPlayerBackButtontapped"/>
                            </Image.GestureRecognizers>
                        </Image>
                        <Image x:Name="PlayerForwardButton"
                               Grid.Row="1"
                               Grid.Column="5"
                               Source="icon_next_player.png"
                               HeightRequest="35"
                               WidthRequest="35"
                               HorizontalOptions="Start"
                               Margin="5"
                               IsEnabled="False">
                            <Image.Shadow>
                                <Shadow Brush="White" Opacity="1.0" Radius="1.0"/>
                            </Image.Shadow>
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPlayerForwardButtontapped"/>
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Border>

                <!-- Displays for reconstruction steps -->
                <Grid Grid.Row="1" Margin="0,5,0,0" RowDefinitions="Auto, Auto" ColumnDefinitions="Auto" HorizontalOptions="Center" VerticalOptions="Center" RowSpacing="14">
                    <Border Grid.Row="0" Margin="0, 0, 0, -10" Style="{StaticResource PanelBorderStyle}" Background="{StaticResource PartialResultsBrush}" Stroke="#2F4F77">
                        <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto, Auto" HorizontalOptions="Center" Margin="18" ColumnSpacing="18">
                            <!-- Calculated Potential -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" HorizontalOptions="Center" Spacing="10">
                                <Label Text="Calculated Potential [mV]" HorizontalOptions="Center" FontFamily="SF Pro Text" FontSize="Small" FontAttributes="Bold" TextColor="#F0F4FF"/>
                                <Border Style="{StaticResource CanvasBorderStyle}" Margin="10" HorizontalOptions="Center">
                                    <Grid RowDefinitions="Auto,Auto">
                                        <skia:SKCanvasView x:Name="PotentialDistributionCanvas" PaintSurface="OnPotentialCanvasPaintSurface" EnableTouchEvents="True" Touch="OnPotentialCanvasTouch" HeightRequest="250" WidthRequest="250" Margin="10" />
                                        <skia:SKCanvasView Grid.Row="1" x:Name="PotentialColorbarCanvas" PaintSurface="OnPotentialColorbarPaintSurface" HeightRequest="20" WidthRequest="250"/>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                            <!-- Adjoint Potential -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" HorizontalOptions="Center" Spacing="10">
                                <Label Text="Adjoint Potential [mV]" HorizontalOptions="Center" FontFamily="SF Pro Text" FontSize="Small" FontAttributes="Bold" TextColor="#F0F4FF"/>
                                <Border Style="{StaticResource CanvasBorderStyle}" Margin="10" HorizontalOptions="Center">
                                    <Grid RowDefinitions="Auto,Auto">
                                        <skia:SKCanvasView x:Name="AdjointDistributionCanvas" PaintSurface="OnAdjointCanvasPaintSurface" EnableTouchEvents="True" Touch="OnAdjointCanvasTouch" HeightRequest="250" WidthRequest="250" Margin="10"/>
                                        <skia:SKCanvasView Grid.Row="1" x:Name="AdjointColorbarCanvas" PaintSurface="OnAdjointColorbarPaintSurface" HeightRequest="20" WidthRequest="250"/>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                            <!-- Gradient -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="2" HorizontalOptions="Center" Spacing="10">
                                <Label Text="Conductivity Gradient [∂Ω]" HorizontalOptions="Center" FontFamily="SF Pro Text" FontSize="Small" FontAttributes="Bold" TextColor="#F0F4FF"/>
                                <Border Style="{StaticResource CanvasBorderStyle}" Margin="10" HorizontalOptions="Center">
                                    <Grid RowDefinitions="Auto,Auto">
                                        <skia:SKCanvasView x:Name="GradientDistributionCanvas" PaintSurface="OnGradientCanvasPaintSurface" EnableTouchEvents="True" Touch="OnGradientCanvasTouch" HeightRequest="250" WidthRequest="250" Margin="10"/>
                                        <skia:SKCanvasView Grid.Row="1" x:Name="GradientColorbarCanvas" PaintSurface="OnGradientColorbarPaintSurface" HeightRequest="20" WidthRequest="250"/>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                            <!-- Original -->
                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" HorizontalOptions="Center" Spacing="10">
                                <Label Text="Original Distribution [S]" HorizontalOptions="Center" FontFamily="SF Pro Text" FontSize="Small" FontAttributes="Bold" TextColor="#F0F4FF"/>
                                <Border Style="{StaticResource CanvasBorderStyle}" Margin="10" HorizontalOptions="Center">
                                    <Grid RowDefinitions="Auto,Auto">
                                        <skia:SKCanvasView x:Name="OriginalDistributionCanvas" PaintSurface="OnOriginalCanvasPaintSurface" EnableTouchEvents="True" Touch="OnOriginalCanvasTouch" HeightRequest="250" WidthRequest="250" Margin="10"/>
                                        <skia:SKCanvasView Grid.Row="1" x:Name="OriginalColorbarCanvas" PaintSurface="OnOriginalColorbarPaintSurface" HeightRequest="20" WidthRequest="250"/>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                            <!-- Initial -->
                            <VerticalStackLayout Grid.Row="2" Grid.Column="1" HorizontalOptions="Center" Spacing="10">
                                <Label Text="Initial Distribution [S]" HorizontalOptions="Center" FontFamily="SF Pro Text" FontSize="Small" FontAttributes="Bold" TextColor="#F0F4FF"/>
                                <Border Style="{StaticResource CanvasBorderStyle}" Margin="10" HorizontalOptions="Center">
                                    <Grid RowDefinitions="Auto,Auto">
                                        <skia:SKCanvasView x:Name="InitialDistributionCanvas" PaintSurface="OnInitialCanvasPaintSurface" EnableTouchEvents="True" Touch="OnInitialCanvasTouch" HeightRequest="250" WidthRequest="250" Margin="10"/>
                                        <skia:SKCanvasView Grid.Row="1" x:Name="InitialColorbarCanvas" PaintSurface="OnInitialColorbarPaintSurface" HeightRequest="20" WidthRequest="250"/>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                            <!-- Reconstructed -->
                            <VerticalStackLayout Grid.Row="3" Grid.Column="2" HorizontalOptions="Center" Spacing="10">
                                <Label Text="Reconstructed Distribution [S]" HorizontalOptions="Center" FontFamily="SF Pro Text" FontSize="Small" FontAttributes="Bold" TextColor="#F0F4FF"/>
                                <Border Style="{StaticResource CanvasBorderStyle}" Margin="10" HorizontalOptions="Center">
                                    <Grid RowDefinitions="Auto,Auto">
                                        <skia:SKCanvasView x:Name="ReconstructedDistributionCanvas" PaintSurface="OnReconstructedCanvasPaintSurface" EnableTouchEvents="True" Touch="OnReconstructedCanvasTouch" HeightRequest="250" WidthRequest="250" Margin="10"/>
                                        <skia:SKCanvasView Grid.Row="1" x:Name="ReconstructedColorbarCanvas" PaintSurface="OnReconstructedColorbarPaintSurface" HeightRequest="20" WidthRequest="250"/>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <Grid Grid.Column="2" 
                  WidthRequest="270"
                  RowDefinitions="Auto, Auto, Auto" 
                  RowSpacing="10" 
                  Margin="5"
                  HorizontalOptions="End">
                <!--
                <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}" Background="{StaticResource HistoryPanelBrush}">
                    <Border.Stroke>
                        <SolidColorBrush Color="{AppThemeBinding Light=#3D5D8C, Dark=#C0CAD8}" />
                    </Border.Stroke>
                    <VerticalStackLayout Margin="16" Spacing="12">
                        <Label Text="Past Reconstructions" HorizontalOptions="Center" FontSize="16"  TextColor="{AppThemeBinding Light=White, Dark=#262E38}"/>
                        <SearchBar Placeholder="Search" Text="{Binding ReconstructionSearchText}" Margin="0"/>
                        <Border Style="{StaticResource PanelSectionBorderStyle}" BackgroundColor="{AppThemeBinding Light=#25334A, Dark=#343C48}">
                            <ScrollView>
