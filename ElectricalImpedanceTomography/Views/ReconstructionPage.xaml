                <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}" Background="{StaticResource StatisticsPanelBrush}">
                    <Border.Stroke>
                        <SolidColorBrush Color="{AppThemeBinding Light=#3A7CA5, Dark=#3A7CA5}" />
                    </Border.Stroke>
                    <VerticalStackLayout Margin="16" Spacing="10">
                        <Label Text="Reconstruction Statistics" HorizontalOptions="Center" FontSize="16"  TextColor="#F0F4FF"/>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding MetricGroups}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:ReconstructionMetricGroupViewModel">
                                    <Border Style="{StaticResource PanelSectionBorderStyle}" BackgroundColor="{AppThemeBinding Light=#252F44, Dark=#252F44}">
                                        <VerticalStackLayout Spacing="5">
                                            <Label Text="{Binding Title}" FontSize="12" FontAttributes="Bold" TextColor="#F0F4FF"/>
                                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Metrics}" Spacing="6">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="viewmodels:ReconstructionMetricViewModel">
                                                        <Border Padding="2"
                                                                StrokeThickness="0"
                                                                BackgroundColor="Transparent"
                                                                StrokeShape="RoundRectangle 6">
                                                            <Border.Triggers>
                                                                <DataTrigger TargetType="Border" Binding="{Binding IsTrendSelected}" Value="True">
                                                                    <Setter Property="StrokeThickness" Value="1.5"/>
                                                                    <Setter Property="Stroke">
                                                                        <Setter.Value>
                                                                            <SolidColorBrush Color="{AppThemeBinding Light=#3A9CED, Dark=#8FD3FF}"/>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#2A354C, Dark=#465268}"/>
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Border" Binding="{Binding IsTrendSelectable}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.75"/>
                                                                </DataTrigger>
                                                            </Border.Triggers>
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding Source={x:Reference ReconstructionPageRoot}, Path=BindingContext.SelectTrendMetricCommand}"
                                                                                      CommandParameter="{Binding Key}"/>
                                                            </Border.GestureRecognizers>
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                                <Label Text="{Binding Name}" FontAttributes="None" FontSize="12" TextColor="#9DAAD3">
                                                                    <Label.Triggers>
                                                                        <DataTrigger TargetType="Label" Binding="{Binding IsTrendSelected}" Value="True">
                                                                            <Setter Property="TextColor" Value="#E3EDFF"/>
                                                                        </DataTrigger>
                                                                    </Label.Triggers>
                                                                </Label>
                                                                <Label Grid.Column="1"
                                                                       Text="{Binding Value}"
                                                                       FontSize="10"
                                                                       TextColor="#F0F4FF"
                                                                       HorizontalOptions="End">
                                                                    <Label.Triggers>
                                                                        <DataTrigger TargetType="Label" Binding="{Binding IsTrendSelected}" Value="True">
                                                                            <Setter Property="TextColor" Value="#FFFFFF"/>
                                                                        </DataTrigger>
                                                                    </Label.Triggers>
                                                                </Label>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <skia:SKCanvasView x:Name="MetricTrendCanvas"
                                                  HeightRequest="170"
                                                  PaintSurface="OnMetricTrendCanvasPaintSurface"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>