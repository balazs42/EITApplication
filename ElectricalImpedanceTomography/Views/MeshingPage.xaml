<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ElectricalImpedanceTomography.Views.MeshingPage"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             xmlns:viewmodels="clr-namespace:ElectricalImpedanceTomography.ViewModels"
             xmlns:controls="clr-namespace:ElectricalImpedanceTomography.Controls"
             xmlns:models="clr-namespace:Utility.Classes.Discretizer;assembly=Utility"
             Title="MeshingPage"
             Shell.NavBarIsVisible="False"
             x:DataType="viewmodels:MeshingPageViewModel"
             BackgroundColor="#090b10">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="AppBackground">#090b10</Color>
            <Color x:Key="PanelBackground">#0E1116</Color>
            <Color x:Key="InputBackground">#050608</Color>
            <Color x:Key="BorderColor">#1AFFFFFF</Color>
            <Color x:Key="PrimaryAccent">#06b6d4</Color>
            <Color x:Key="TextPrimary">#e2e8f0</Color>
            <Color x:Key="TextSecondary">#94a3b8</Color>
            <Color x:Key="TextMuted">#64748b</Color>

            <PathGeometry x:Key="IconActivity" Figures="M22 12h-4l-3 9L9 3l-3 9H2"/>
            <PathGeometry x:Key="IconSearch" Figures="M21 21l-4.35-4.35 M19 11a8 8 0 1 1-8-8 8 8 0 0 1 8 8z"/>
            <PathGeometry x:Key="IconDatabase" Figures="M12 2c5 0 9 1.3 9 3s-4 3-9 3-9-1.3-9-3 4-3 9-3z M21 12c0 1.7-4 3-9 3s-9-1.3-9-3 M3 5v14c0 1.7 4 3 9 3s9-1.3 9-3V5"/>
            <PathGeometry x:Key="IconChevronDown" Figures="M6 9l6 6 6-6"/>

            <Style TargetType="Label" x:Key="HeaderLabel">
                <Setter Property="FontSize" Value="Small"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
                <Setter Property="TextTransform" Value="Uppercase"/>
                <Setter Property="Margin" Value="0,16,0,8"/>
            </Style>

            <Style TargetType="Label" x:Key="PropLabel">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
                <Setter Property="VerticalOptions" Value="Center"/>
            </Style>

            <Style TargetType="Picker">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="TitleColor" Value="{StaticResource TextSecondary}"/>
            </Style>

            <Style TargetType="Button" x:Key="ToolbarBtn">
                <Setter Property="BackgroundColor" Value="#1A1D24"/>
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
                <Setter Property="FontSize" Value="Small"/>
                <Setter Property="FontAttributes" Value="Italic"/>
                <Setter Property="BorderColor" Value="{StaticResource BorderColor}"/>
                <Setter Property="BorderWidth" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="HeightRequest" Value="32"/>
                <Setter Property="Padding" Value="12,0"/>
            </Style>

            <Style TargetType="Button" x:Key="PrimaryBtn">
                <Setter Property="BackgroundColor" Value="#0891b2"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="FontSize" Value="Small"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="BorderColor" Value="#06b6d4"/>
                <Setter Property="BorderWidth" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="HeightRequest" Value="32"/>
                <Setter Property="Padding" Value="12,0"/>
            </Style>

            <!-- Explicitly define PropEntry here as well if needed by direct usage, though controls handle themselves -->
            <Style TargetType="Entry" x:Key="PropEntry">
                <Setter Property="BackgroundColor" Value="{StaticResource InputBackground}"/>
                <Setter Property="TextColor" Value="{StaticResource PrimaryAccent}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontFamily" Value="Monospace"/>
                <Setter Property="HorizontalTextAlignment" Value="Center"/>
                <Setter Property="HeightRequest" Value="24"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        
        <!-- Main Content Area -->
        <Grid Grid.Row="1" ColumnDefinitions="340, *, 280">

            <!-- 2. Left Property Inspector -->
            <Border Grid.Column="0" BackgroundColor="{StaticResource PanelBackground}" Stroke="{StaticResource BorderColor}" StrokeThickness="0">
                <Grid RowDefinitions="Auto, *, Auto">
                    <VerticalStackLayout Grid.Row="0" Padding="16,16,16,0" Spacing="8">
                        <Label Text="SOLVER METHOD" Style="{StaticResource HeaderLabel}" Margin="0"/>
                        <Grid ColumnDefinitions="*, Auto">
                            <Picker ItemsSource="{Binding MeshTypes}" 
                                    FontSize="Micro"
                                    SelectedItem="{Binding SelectedMeshType}"
                                    VerticalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                    <ScrollView Grid.Row="1" Padding="16,0,16,16">
                        <VerticalStackLayout>

                            <!-- FEM Controls -->
                            <VerticalStackLayout IsVisible="{Binding IsFEM}" Spacing="2">
                                <Label Text="DISCRETIZATION" Style="{StaticResource HeaderLabel}"/>
                                <Label Text="Geometry" Style="{StaticResource PropLabel}" Margin="0,0,0,4"/>
                                    <Picker ItemsSource="{Binding GeometryTypes}" SelectedItem="{Binding SelectedGeometry}" FontSize="Micro" VerticalOptions="Center"/>
                               
                                <controls:PlusMinusEntryControl LabelText="Layers" 
                                                                Value="{Binding Layers}" 
                                                                Min="1" Max="20" />

                                <controls:PlusMinusEntryControl LabelText="Boundary Vertices" 
                                                                Value="{Binding BoundaryFEMVertexCount}" 
                                                                Min="3" Max="100" />

                                <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" Margin="0,8"/>

                                <Label Text="ELECTRODES" Style="{StaticResource HeaderLabel}"/>

                                <controls:PlusMinusEntryControl LabelText="Count" 
                                                                Value="{Binding ElectrodeCount}" 
                                                                Min="0" Max="32" />

                                <controls:PlusMinusEntryControl LabelText="Nodes / Electrode" 
                                                                Value="{Binding FemElectrodeNodeCount}" 
                                                                Min="1" Max="5" />

                                <controls:PlusMinusEntryControl LabelText="Contact Impedance" 
                                                                Value="{Binding ElectrodeContactImpedance}" 
                                                                Min="0" Max="10" />

                                <controls:PlusMinusEntryControl LabelText="Electrode Size [%]" 
                                                                Value="{Binding ElectrodeSize}" 
                                                                Min="0" Max="100" />

                                <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" Margin="0,8"/>

                                <Label Text="CONFIGURATION" Style="{StaticResource HeaderLabel}"/>

                                <Grid ColumnDefinitions="*, 50" Margin="0,0,0,8">
                                    <Label Text="Use Virtual Electrodes" Style="{StaticResource PropLabel}"/>
                                    <Switch Grid.Column="1" IsToggled="{Binding VirtualElectrodeSettings.UseVirtualElectrodes}" OnColor="{StaticResource PrimaryAccent}" HorizontalOptions="End"/>
                                </Grid>

                                <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding VirtualElectrodeSettings.UseVirtualElectrodes}" Margin="0,0,0,12">
                                    <Label Text="Virtual per gap" Style="{StaticResource PropLabel}"/>
                                    <Entry Grid.Column="1" VerticalOptions="End" Text="{Binding VirtualElectrodeSettings.VirtualElectrodesPerGap}" Style="{StaticResource PropEntry}" HorizontalOptions="End"/>
                                </Grid>

                                <Label Text="Drive Pattern" Style="{StaticResource PropLabel}" Margin="0,0,0,4"/>
                                <Picker ItemsSource="{Binding DrivePatterns}" SelectedItem="{Binding SelectedDrivePattern}" FontSize="Micro" VerticalOptions="Center"/>
                            </VerticalStackLayout>

                            <!-- LBM Controls -->
                            <VerticalStackLayout IsVisible="{Binding IsLBM}" Spacing="2">
                                <Label Text="GRID PARAMETERS" Style="{StaticResource HeaderLabel}"/>

                                <Label Text="Geometry" Style="{StaticResource PropLabel}" Margin="0,0,0,4"/>
                                <Picker ItemsSource="{Binding GeometryTypes}" SelectedItem="{Binding SelectedGeometry}" FontSize="Micro" VerticalOptions="Center"/>

                                <controls:PlusMinusEntryControl LabelText="Width (X)" 
                                                                Value="{Binding Nx}" 
                                                                Min="10" Max="200" />

                                <controls:PlusMinusEntryControl LabelText="Height (Y)" 
                                                                Value="{Binding Ny}" 
                                                                Min="10" Max="200" />

                                <controls:PlusMinusEntryControl LabelText="Electrode Num" 
                                                                Value="{Binding ElectrodeCount}" 
                                                                Min="0" Max="64" />

                                <controls:PlusMinusEntryControl LabelText="Inhomogeneity Value" 
                                                                Value="{Binding InhomogenityValue}" 
                                                                Min="0" Max="10" />

                                <controls:PlusMinusEntryControl LabelText="Contact Impedance" 
                                                                Value="{Binding ElectrodeContactImpedance}" 
                                                                Min="0" Max="10" />

                                <Grid ColumnDefinitions="*, 50" Margin="0,0,0,8">
                                    <Label Text="Use Virtual Electrodes" Style="{StaticResource PropLabel}"/>
                                    <Switch Grid.Column="1" IsToggled="{Binding VirtualElectrodeSettings.UseVirtualElectrodes}" OnColor="{StaticResource PrimaryAccent}"/>
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>

                    <Border Grid.Row="2" Padding="16" BackgroundColor="#0b0e12" Stroke="{StaticResource BorderColor}" StrokeThickness="0">
                        <Button Text="MATLAB EXPORT" Clicked="OnMatlabExportClicked"
                                 BackgroundColor="#1A06b6d4" TextColor="{StaticResource PrimaryAccent}"
                                 BorderColor="#3306b6d4" BorderWidth="1" FontSize="11" FontAttributes="Bold"
                                 HeightRequest="40" CornerRadius="6"
                                 IsEnabled="{Binding IsFEM}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 3. Center Canvas & Toolbar -->
            <Grid Grid.Column="1" RowDefinitions="56, *" BackgroundColor="{StaticResource AppBackground}">
                <!-- Integrated Toolbar -->
                <Border Grid.Row="0" BackgroundColor="{StaticResource PanelBackground}" Stroke="{StaticResource BorderColor}" StrokeThickness="0">
                    <Grid ColumnDefinitions="Auto, *, Auto" Padding="16,0">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                            <Button Style="{StaticResource PrimaryBtn}" Clicked="OnGenerateClicked" Text="GENERATE" />
                            <BoxView WidthRequest="1" Color="{StaticResource BorderColor}" Margin="4,8"/>
                            <Button Style="{StaticResource ToolbarBtn}" Text="SAVE" Clicked="OnSaveClicked"/>
                            <Button Style="{StaticResource ToolbarBtn}" Text="LOAD" Clicked="OnLoadClicked"/>
                            <Button Style="{StaticResource ToolbarBtn}" Text="CLEAR" TextColor="#f87171" Clicked="OnClearClicked"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                            <Border Stroke="{StaticResource BorderColor}" BackgroundColor="{StaticResource InputBackground}" StrokeShape="RoundRectangle 4" HeightRequest="32" Padding="4,0">
                                <HorizontalStackLayout>
                                    <ImageButton Clicked="OnUndoClicked" HeightRequest="24" WidthRequest="28" BackgroundColor="Transparent">
                                        <ImageButton.Source>
                                            <FontImageSource Glyph="&#x27F2;" Color="{StaticResource TextSecondary}" Size="16"/>
                                        </ImageButton.Source>
                                    </ImageButton>
                                    <BoxView WidthRequest="1" Color="{StaticResource BorderColor}" Margin="0,4"/>
                                    <ImageButton Clicked="OnRedoClicked" HeightRequest="24" WidthRequest="28" BackgroundColor="Transparent">
                                        <ImageButton.Source>
                                            <FontImageSource Glyph="&#x27F3;" Color="{StaticResource TextSecondary}" Size="16"/>
                                        </ImageButton.Source>
                                    </ImageButton>
                                </HorizontalStackLayout>
                            </Border>

                            <BoxView WidthRequest="1" Color="{StaticResource BorderColor}" Margin="4,8"/>

                            <Border Stroke="{StaticResource PrimaryAccent}" StrokeThickness="1" BackgroundColor="#1A06b6d4" StrokeShape="RoundRectangle 4" Padding="8,4">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <HorizontalStackLayout IsVisible="{Binding InhomogenityEditing}" Padding="5" Spacing="10">
                                        <Label Text="Inhomogeneity Value" Style="{StaticResource PropLabel}"/>
                                        <Entry Text="{Binding InhomogenityValue}" Style="{StaticResource PropEntry}" FontSize="Micro" HorizontalOptions="Fill"/>
                                    </HorizontalStackLayout>
                                    <Grid ColumnDefinitions="40, *">
                                        <CheckBox Grid.Column="0" HorizontalOptions="Center" ScaleX="1" ScaleY="1" VerticalOptions="Center" IsChecked="{Binding InhomogenityEditing}" Color="{StaticResource PrimaryAccent}"/>
                                        <Label Grid.Column="1" HorizontalOptions="Center" Text="EDIT MODE" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource PrimaryAccent}" VerticalOptions="Center"/>
                                    </Grid>
                                </HorizontalStackLayout>
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- Canvas Area -->
                <Grid Grid.Row="1" BackgroundColor="#090b10">
                    <!-- Wrapper for Centering and Size Restriction -->
                    <Border HorizontalOptions="Center" VerticalOptions="Center" 
                            WidthRequest="750" HeightRequest="750"
                            Stroke="{StaticResource BorderColor}" StrokeThickness="1"
                            BackgroundColor="#13161C">
                        <Grid>
                            <skia:SKCanvasView x:Name="MeshCanvas"
                                               PaintSurface="OnMeshCanvasPaintSurface"
                                               EnableTouchEvents="True"
                                               Touch="OnMeshCanvasTouch"
                                               HorizontalOptions="Fill" VerticalOptions="Fill"/>

                            <!-- Overlay Stats -->
                            <Border HorizontalOptions="End" VerticalOptions="Start" Margin="10" 
                                    BackgroundColor="#CC0E1116" Stroke="{StaticResource BorderColor}" 
                                    StrokeShape="RoundRectangle 6" Padding="8">
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="MESH STATISTICS" Style="{StaticResource HeaderLabel}" FontSize="9" Margin="0,0,0,2"/>
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="Nodes:" Style="{StaticResource PropLabel}" FontFamily="Monospace" FontSize="10"/>
                                        <Label Text="257" TextColor="{StaticResource PrimaryAccent}" FontFamily="Monospace" FontSize="10" FontAttributes="Bold"/>
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="Elems:" Style="{StaticResource PropLabel}" FontFamily="Monospace" FontSize="10"/>
                                        <Label Text="512" TextColor="{StaticResource PrimaryAccent}" FontFamily="Monospace" FontSize="10" FontAttributes="Bold"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 3. Right Library Panel -->
            <Border Grid.Column="2" BackgroundColor="{StaticResource PanelBackground}" Stroke="{StaticResource BorderColor}" StrokeThickness="0">
                <Grid RowDefinitions="Auto, *">
                    <VerticalStackLayout Grid.Row="0" Padding="16" Spacing="12">
                        <HorizontalStackLayout Spacing="8">
                            <Path Data="{StaticResource IconDatabase}" Fill="{StaticResource PrimaryAccent}" Scale="0.6"/>
                            <Label Text="LIBRARY" Style="{StaticResource HeaderLabel}" Margin="0" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <Border BackgroundColor="{StaticResource InputBackground}" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 6" HeightRequest="32" Padding="8,0">
                            <Grid ColumnDefinitions="24, *">
                                <Path Grid.Column="0" Data="{StaticResource IconSearch}" Fill="{StaticResource TextMuted}" Scale="0.6" VerticalOptions="Center" HorizontalOptions="Center"/>
                                <Entry Grid.Column="1" Placeholder="Filter..." PlaceholderColor="{StaticResource TextMuted}" 
                                       Text="{Binding MeshSearchText}" BackgroundColor="Transparent" FontSize="11" TextColor="{StaticResource TextPrimary}" Margin="-5,0,0,0" HorizontalTextAlignment="Start"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <ScrollView Grid.Row="1" Padding="8,0">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding FilteredMeshes}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate <!--x:DataType="models:DiscretizationInfo"-->>
                                    <Border BackgroundColor="#13161C" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 6" Padding="10">
                                        <Grid RowDefinitions="Auto, Auto">
                                            <Label Grid.Row="0" Text="{Binding Name}" TextColor="{StaticResource TextPrimary}" FontSize="Small" FontAttributes="Bold" FontFamily="SF Pro Text" LineBreakMode="TailTruncation"/>
                                            <Grid Grid.Row="1" ColumnDefinitions="Auto, *" Margin="0,4,0,0">
                                                <Label Grid.Column="0" Text="{Binding Generator}" FontSize="9" TextColor="{StaticResource TextMuted}" BackgroundColor="#090b10" Padding="4,2"/>
                                                <Label Grid.Column="1" Text="{Binding Metadata.CreatedOn, StringFormat='{0:MM/dd HH:mm}'}" FontSize="Micro" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center"/>
                                            </Grid>
                                        </Grid>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnMeshSelected"/>
                                        </Border.GestureRecognizers>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>