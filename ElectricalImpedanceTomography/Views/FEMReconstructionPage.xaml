<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ElectricalImpedanceTomography.Views.FEMReconstructionPage"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             xmlns:viewmodels="clr-namespace:ElectricalImpedanceTomography.ViewModels"
             x:DataType="viewmodels:FEMReconstructionPageViewModel"
             Title="FEMReconstructionPage">
    <ContentPage.Resources>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="Medium"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="BackgroundColor" Value="#555555"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontFamily" Value="Roboto-Bold"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="MinimumHeightRequest" Value="30"/>

            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">

                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="1.0" />
                                <Setter Property="BackgroundColor" Value="#555555" />
                                <Setter Property="Opacity" Value="1.0"/>
                            </VisualState.Setters>
                        </VisualState>

                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#444444" />
                                <Setter Property="Scale" Value="0.95" />
                            </VisualState.Setters>
                        </VisualState>

                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>
    
    <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*" RowSpacing="10">
        <!-- radius & boundary nodes -->

        <Grid Grid.Row="0"
              HorizontalOptions="Center"
              RowSpacing="5"
              ColumnSpacing="10"              
              RowDefinitions="Auto, Auto, Auto, Auto"
              ColumnDefinitions="*, *, *, *, *,*, *, *, *, *">
            
            <Label Grid.Row="0" Grid.Column="0" Text="Layers:" VerticalOptions="Center" HorizontalOptions="Center"/>
            <Entry Grid.Row="1" Grid.Column="0"
                   WidthRequest="80"
                   Keyboard="Numeric"
                   Text="{Binding Layers}"/>

            <Label Grid.Row="0" Grid.Column="1" Text="Boundary nodes:" VerticalOptions="Center" HorizontalOptions="Center"/>
            <Entry Grid.Row="1" Grid.Column="1"
                   WidthRequest="80" 
                   Keyboard="Numeric"
                   Text="{Binding BoundaryNodeCount}"/>

            <Label Grid.Row="0" Grid.Column="2" Text="Electrode Count:" VerticalOptions="Center" HorizontalOptions="Center"/>
            <Entry Grid.Row="1" Grid.Column="2"
                   WidthRequest="80" 
                   Keyboard="Numeric"
                   Text="{Binding ElectrodeCount}"/>

            <Label Grid.Row="0" Grid.Column="3" Text="Excitation Id:" VerticalOptions="Center" HorizontalOptions="Center"/>
            <Entry Grid.Row="1" Grid.Column="3"
                   WidthRequest="80" 
                   Keyboard="Numeric"
                   Text="{Binding ExcitationElectrodeId}"/>

            <Label Grid.Row="0" Grid.Column="4" Text="Ground Id:" VerticalOptions="Center" HorizontalOptions="Center"/>
            <Entry Grid.Row="1" Grid.Column="4"
                   WidthRequest="80" 
                   Keyboard="Numeric"
                   Text="{Binding GroundElectrodeId}"/>

            <Label Grid.Row="0" Grid.Column="5" Text="Current[mA]:" VerticalOptions="Center" HorizontalOptions="Center"/>
            <Entry Grid.Row="1" Grid.Column="5"
                   WidthRequest="80" 
                   Keyboard="Numeric"
                   Text="{Binding ExcitationCurrentAmplitude}"/>

            <Label Grid.Row="2" Grid.Column="0" Text="Electrode Size[%]:" VerticalOptions="Center" HorizontalOptions="Center"/>
            <Entry Grid.Row="4" Grid.Column="0"
                   WidthRequest="80" 
                   Keyboard="Numeric"
                   Text="{Binding ElectrodeSurfaceLength}"/>

            <Label Grid.Row="2" Grid.Column="1" Text="Contact Impedance [mΩ]:" VerticalOptions="Center" HorizontalOptions="Center"/>
            <Entry Grid.Row="4" Grid.Column="1"
                   WidthRequest="80" 
                   Keyboard="Numeric"
                   Text="{Binding ContactImpedance}"/>

            <Label Grid.Row="2" Grid.Column="2" Text="Inhomogenity [mS]:" VerticalOptions="Center" HorizontalOptions="Center"/>
            <Entry Grid.Row="4" Grid.Column="2"
                   WidthRequest="80" 
                   Keyboard="Numeric"
                   Text="{Binding InhomogenityValue}"/>

            <Label Grid.Row="2" Grid.Column="3" Text="Max iteration count:" VerticalOptions="Center" HorizontalOptions="Center"/>
            <Entry Grid.Row="4" Grid.Column="3"
                   WidthRequest="80" 
                   Keyboard="Numeric"
                   Text="{Binding MaxIterationCount}"/>

            <Label Grid.Row="2" Grid.Column="4" Text="Gradient Step Size (β):" VerticalOptions="Center" HorizontalOptions="Center"/>
            <Entry Grid.Row="4" Grid.Column="4"
                   WidthRequest="80" 
                   Keyboard="Numeric"
                   Text="{Binding StepSize}"/>

            <Label Grid.Row="2" Grid.Column="5" Text="Regularization Weight (θ):" VerticalOptions="Center" HorizontalOptions="Center"/>
            <Entry Grid.Row="4" Grid.Column="5"
                   WidthRequest="80" 
                   Keyboard="Numeric"
                   Text="{Binding RegularizationWeight}"/>
        </Grid>


        <!-- buttons -->
        <Grid Grid.Row="1"
              RowDefinitions="Auto" 
              ColumnDefinitions="Auto, Auto, Auto, Auto, Auto, Auto" 
              HorizontalOptions="Center" 
              Padding="10"
              ColumnSpacing="10">

            <Button Style="{StaticResource ButtonStyle}"
                    Grid.Column="0"
                    Text="Generate Mesh" 
                    Clicked="OnGenerateMeshClicked"/>
            
            <Picker Grid.Column="1"
                    x:Name="PotentialModePicker"
                    Title="Potential Display Mode"
                    SelectedIndexChanged="OnPotentialModeChanged">
                <Picker.Items>
                    <x:String>Default</x:String>
                    <x:String>Grayscale</x:String>
                    <x:String>Inverted</x:String>
                    <x:String>Heatmap</x:String>
                    <x:String>Rainbow</x:String>
                </Picker.Items>
            </Picker>
            
            <Button Style="{StaticResource ButtonStyle}"
                    Grid.Column="2" 
                    Text="Solve Forward" 
                    Clicked="OnSolveForwardClicked"/>

            <Button Style="{StaticResource ButtonStyle}"
                    Grid.Column="3" 
                    Text="Solve Inverse"  
                    Clicked="OnSolveInverseClicked"/>

            <Button x:Name="StartStopButton"
                    Style="{StaticResource ButtonStyle}"
                    Grid.Column="4"
                    Text="Stop"
                    Clicked="StartStopButtonClicked"/>
            
            <Button Style="{StaticResource ButtonStyle}"
                    Grid.Column="5"
                    Text="Step"
                    Clicked="StepButtonClicked"/>


        </Grid>

        <!-- 3) Side-by-side meshes -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,*,*" 
              RowDefinitions="Auto,*,Auto" 
              ColumnSpacing="10" 
              Padding="10">

            <!-- Potential column -->
            <Label Grid.Row="0" 
                   Grid.Column="0"
                   Padding="10"
                   Margin="10"
                   Text="Potential Distribution"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>
            <skia:SKCanvasView Grid.Row="1" Grid.Column="0"                               
                               x:Name="PotentialCanvas"
                               PaintSurface="OnPotentialPaintSurface"
                               EnableTouchEvents="True"
                               Touch="OnPotentialCanvasTouch"/>
            <skia:SKCanvasView Grid.Row="2" Grid.Column="0"
                               x:Name="PotentialColorbar"
                               HeightRequest="40"
                               WidthRequest="500"                               
                               PaintSurface="OnPotentialColorbarPaintSurface"/>

            <!-- Conductivity column -->
            <Label Grid.Row="0" Grid.Column="1"
                   Padding="10"
                   Text="Conductivity Distribution"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>
            <skia:SKCanvasView Grid.Row="1" Grid.Column="1"
                               x:Name="ConductivityCanvas"
                               PaintSurface="OnConductivityPaintSurface"
                               EnableTouchEvents="True"
                               Touch="OnConductivityCanvasTouch"/>
            <skia:SKCanvasView Grid.Row="2" Grid.Column="1"
                               x:Name="ConductivityColorbar"
                               HeightRequest="40"
                               WidthRequest="500"
                               PaintSurface="OnConductivityColorbarPaintSurface"/>

            <!-- Reconstruction column -->
            <Label Grid.Row="0" 
                   Grid.Column="2"
                   Padding="10"
                   Margin="10"
                   Text="Reconstruction Result"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>
            <skia:SKCanvasView Grid.Row="1" Grid.Column="2"                               
                               x:Name="ReconstructionCanvas"
                               PaintSurface="OnReconstructionPaintSurface"
                               EnableTouchEvents="True"
                               Touch="OnReconstructionTouch"/>
            <skia:SKCanvasView Grid.Row="2" Grid.Column="2"
                               x:Name="ReconstructionColorbar"
                               HeightRequest="40"
                               WidthRequest="500"                               
                               PaintSurface="OnReconstructionColorbarPaintSurface"/>

        </Grid>
    </Grid>
</ContentPage>