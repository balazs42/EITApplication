<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ElectricalImpedanceTomography.Views.FEMReconstructionPage"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             xmlns:viewmodels="clr-namespace:ElectricalImpedanceTomography.ViewModels"
             xmlns:controls="clr-namespace:ElectricalImpedanceTomography.Controls"
             x:DataType="viewmodels:FEMReconstructionPageViewModel"
             Shell.NavBarIsVisible="False"
             Title="FEMReconstructionPage">
    <ContentPage.Resources>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="Medium"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="BackgroundColor" Value="#555555"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontFamily" Value="Roboto-Bold"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="MinimumHeightRequest" Value="30"/>

            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">

                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="1.0" />
                                <Setter Property="BackgroundColor" Value="#555555" />
                                <Setter Property="Opacity" Value="1.0"/>
                            </VisualState.Setters>
                        </VisualState>

                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#444444" />
                                <Setter Property="Scale" Value="0.95" />
                            </VisualState.Setters>
                        </VisualState>

                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,Auto,Auto,*" ColumnDefinitions="*" RowSpacing="10">
        
        <controls:NavBarControl Grid.Row="0" Grid.ColumnSpan="2" CurrentPageName="FEMReconstructionPage"/>
        <controls:ReconstructionParametersControl Grid.Row="1" PotentialModeChanged="OnPotentialModeChanged" />


        <!-- buttons -->
        <Grid Grid.Row="2"
              RowDefinitions="Auto"
              ColumnDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto"
              HorizontalOptions="Center"
              Padding="10"
              ColumnSpacing="10">

            <Button Style="{StaticResource ButtonStyle}"
                    Grid.Column="0"
                    Text="Generate Mesh"
                    Clicked="OnGenerateMeshClicked"/>

            <Button Style="{StaticResource ButtonStyle}"
                    Grid.Column="1"
                    Text="Solve Forward"
                    Clicked="OnSolveForwardClicked"/>

            <Button Style="{StaticResource ButtonStyle}"
                    Grid.Column="2"
                    Text="Solve Inverse"
                    Clicked="OnSolveInverseClicked"/>

            <Button x:Name="StartStopButton"
                    Style="{StaticResource ButtonStyle}"
                    Grid.Column="3"
                    Text="Start"
                    Clicked="StartStopButtonClicked"/>

            <Button x:Name="StopButton"
                    Style="{StaticResource ButtonStyle}"
                    Grid.Column="4"
                    Text="Stop"
                    Clicked="StopButtonClicked"/>

            <Button Style="{StaticResource ButtonStyle}"
                    Grid.Column="5"
                    Text="Step"
                    Clicked="StepButtonClicked"/>

            <Button Style="{StaticResource ButtonStyle}"
                    Grid.Column="6"
                    Text="Edit Boundary Conditions"
                    Clicked="OnEditBoundaryConditions"/>

        </Grid>

        <!-- 3) Side-by-side meshes -->
        <Grid Grid.Row="3"
              ColumnDefinitions="*,*,*" 
              RowDefinitions="Auto,*,Auto" 
              ColumnSpacing="10" 
              Padding="10">

            <!-- Potential column -->
            <Label Grid.Row="0" 
                   Grid.Column="0"
                   Padding="10"
                   Margin="10"
                   Text="Potential Distribution"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>
            <skia:SKCanvasView Grid.Row="1" Grid.Column="0"                               
                               x:Name="PotentialCanvas"
                               PaintSurface="OnPotentialPaintSurface"
                               EnableTouchEvents="True"
                               Touch="OnPotentialCanvasTouch"/>
            <skia:SKCanvasView Grid.Row="2" Grid.Column="0"
                               x:Name="PotentialColorbar"
                               HeightRequest="40"
                               WidthRequest="500"                               
                               PaintSurface="OnPotentialColorbarPaintSurface"/>

            <!-- Conductivity column -->
            <Label Grid.Row="0" Grid.Column="1"
                   Padding="10"
                   Text="Conductivity Distribution"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>
            <skia:SKCanvasView Grid.Row="1" Grid.Column="1"
                               x:Name="ConductivityCanvas"
                               PaintSurface="OnConductivityPaintSurface"
                               EnableTouchEvents="True"
                               Touch="OnConductivityCanvasTouch"/>
            <skia:SKCanvasView Grid.Row="2" Grid.Column="1"
                               x:Name="ConductivityColorbar"
                               HeightRequest="40"
                               WidthRequest="500"
                               PaintSurface="OnConductivityColorbarPaintSurface"/>

            <!-- Reconstruction column -->
            <Label Grid.Row="0" 
                   Grid.Column="2"
                   Padding="10"
                   Margin="10"
                   Text="Reconstruction Result"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>
            <skia:SKCanvasView Grid.Row="1" Grid.Column="2"                               
                               x:Name="ReconstructionCanvas"
                               PaintSurface="OnReconstructionPaintSurface"
                               EnableTouchEvents="True"
                               Touch="OnReconstructionTouch"/>
            <skia:SKCanvasView Grid.Row="2" Grid.Column="2"
                               x:Name="ReconstructionColorbar"
                               HeightRequest="40"
                               WidthRequest="500"                               
                               PaintSurface="OnReconstructionColorbarPaintSurface"/>

        </Grid>
    </Grid>
</ContentPage>