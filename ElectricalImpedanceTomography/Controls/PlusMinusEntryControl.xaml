<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ElectricalImpedanceTomography.Controls.PlusMinusEntryControl"
             x:Name="Root">
    <ContentView.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryAccent">#06b6d4</Color>
            <Color x:Key="TextSecondary">#94a3b8</Color>
            <Color x:Key="InputBackground">#050608</Color>
            <Color x:Key="BorderColor">#1AFFFFFF</Color>

            <Style TargetType="Button" x:Key="MiniBtn">
                <Setter Property="BackgroundColor" Value="#1A1D24"/>
                <Setter Property="TextColor" Value="#e2e8f0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="BorderColor" Value="{StaticResource BorderColor}"/>
                <Setter Property="BorderWidth" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="HeightRequest" Value="30"/>
                <Setter Property="WidthRequest" Value="20"/>
                <Setter Property="Padding" Value="0"/>
            </Style>

            <Style TargetType="Entry" x:Key="PropEntry">
                <Setter Property="BackgroundColor" Value="{StaticResource InputBackground}"/>
                <Setter Property="TextColor" Value="{StaticResource PrimaryAccent}"/>
                <Setter Property="FontSize" Value="Micro"/>
                <Setter Property="FontFamily" Value="Monospace"/>
                <Setter Property="MaximumHeightRequest" Value="24"/>
            </Style>

            <Style TargetType="Slider">
                <Setter Property="MinimumTrackColor" Value="{StaticResource PrimaryAccent}"/>
                <Setter Property="MaximumTrackColor" Value="#1A1D24"/>
                <Setter Property="ThumbColor" Value="#e2e8f0"/>
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>

    <VerticalStackLayout Spacing="2">
        <!-- Label Row -->
        <Label Text="{Binding Source={x:Reference Root}, Path=LabelText}"
               FontSize="Micro"
               TextColor="{StaticResource TextSecondary}"
               VerticalOptions="Center"
               Margin="0,4,0,4"/>

        <!-- Control Row -->
        <Grid ColumnDefinitions="*, Auto, 50, Auto" ColumnSpacing="8" Margin="0,0,0,12">
            <Slider Grid.Column="0"
                    VerticalOptions="Center"
                    Value="{Binding Source={x:Reference Root}, Path=Value}"
                    Minimum="{Binding Source={x:Reference Root}, Path=Min}"
                    Maximum="{Binding Source={x:Reference Root}, Path=Max}"/>

            <Button Grid.Column="1" Text="-" Style="{StaticResource MiniBtn}" Clicked="OnMinusClicked"/>

            <Entry Grid.Column="2" 
                   Text="{Binding Source={x:Reference Root}, Path=Value}"
                   Style="{StaticResource PropEntry}" 
                   Keyboard="Numeric"/>

            <Button Grid.Column="3" Text="+" Style="{StaticResource MiniBtn}" Clicked="OnPlusClicked"/>
        </Grid>
    </VerticalStackLayout>
</ContentView>